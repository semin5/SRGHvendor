{
  "uid": "server-monitoring",
  "title": "server_monitoring",
  "description": "1.78의 3306은 현재 MariaDB가 아닌 MySQL이므로 MariaDB 상태는 DOWN으로 표시됩니다. 포트 상태는 192.168.1.76 TCP 접속 기준입니다.",
  "tags": ["SRGH_IT", "server"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 5,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "1.77 / 1.78 / 1.249 서버 상태", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"srgh-host\"}", "legendFormat": "{{instance}}"}, {"refId": "B", "expr": "max(srgh_peer_up{peer=\"1.249\"})", "legendFormat": "192.168.1.249"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "stat", "title": "MySQL 현재 프라이머리 (3307 / 3308)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "srgh_db_primary{engine=\"mysql\",port=~\"3307|3308\"} == 1", "legendFormat": "{{port}}: 192.168.{{node}}", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "type": "stat", "title": "1.76 포트 3000~3017 TCP 상태", "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "max by (port) (srgh_vip_port_up)", "legendFormat": "{{port}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "type": "timeseries", "title": "호스트 CPU 사용률", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "srgh_node_cpu_usage_percent", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 5, "type": "stat", "title": "MySQL / MariaDB 상태", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "srgh_db_up", "legendFormat": "{{node}} {{engine}}:{{port}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6, "type": "timeseries", "title": "DB 현재 연결 / 최대 연결", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "srgh_db_connections", "legendFormat": "{{node}} {{engine}}:{{port}} 현재"}, {"refId": "B", "expr": "srgh_db_max_connections", "legendFormat": "{{node}} {{engine}}:{{port}} 최대"}, {"refId": "C", "expr": "srgh_db_max_used_connections", "legendFormat": "{{node}} {{engine}}:{{port}} 최고 사용 이력"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 7, "type": "timeseries", "title": "DB 연결 사용률", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "srghtalk-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * srgh_db_connections / srgh_db_max_connections", "legendFormat": "{{node}} {{engine}}:{{port}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}}
    }
  ]
}
